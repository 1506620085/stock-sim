########################################
# 模式 A：一体机（单容器 = 前端 + API + PostgreSQL + MinIO）
#
# 用法：
#   cp .env.example.A .env                 # Linux / macOS
#   Copy-Item .env.example.A .env          # Windows PowerShell
#   # 按需改 CORS_ORIGINS / MINIO_PUBLIC_ENDPOINT / 密码
#   docker compose -f docker-compose.allinone.yml up -d --build
#
# 说明：
#   - DATABASE_URL / MINIO_ENDPOINT 在容器内由 compose 固定为 127.0.0.1，一般无需改
#   - 局域网访问时务必将 CORS 与 MINIO_PUBLIC_ENDPOINT 改成「浏览器能打开」的地址
#   - 不要用 https://，也不要写 0.0.0.0
########################################

APP_ENV=production
TIMEZONE=Asia/Shanghai
MARKET_DATA_PROVIDER=akshare

WEB_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 本机访问可保留；局域网请改成 http://你的局域网IP:8080（可多项逗号分隔）
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRUST_PROXY_HEADERS=true

# 前端构建 API 基址：留空 = 相对路径 /api（推荐）
VITE_API_BASE_URL=

########################################
# PostgreSQL（一体机容器内自建，默认账号如下）
########################################
POSTGRES_DB=stock_sim
POSTGRES_USER=stock_sim
POSTGRES_PASSWORD=stock_sim

########################################
# MinIO（一体机容器内自建）
########################################
STORAGE_TYPE=minio
# 容器内地址（compose 会覆盖为 http://127.0.0.1:9000，此处仅作说明）
MINIO_ENDPOINT=http://127.0.0.1:9000
# 浏览器打开对象 URL 的地址；局域网请改为 http://你的局域网IP:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stock-review
MINIO_USE_SSL=false
MINIO_REGION=

TUSHARE_TOKEN=
