########################################
# Docker Compose 环境变量（复制为仓库根目录 .env 后按需修改）
#   copy .env.example .env        # Windows
#   cp .env.example .env          # macOS / Linux
########################################

APP_ENV=production
TIMEZONE=Asia/Shanghai
MARKET_DATA_PROVIDER=akshare

# 浏览器访问前端地址（需与实际 WEB_PORT 一致）
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 浏览器打开站点的来源，逗号分隔（CORS）
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRUST_PROXY_HEADERS=true

# 前端构建时 API 基址：留空表示使用相对路径 /api（推荐，由 Nginx 反代）
VITE_API_BASE_URL=

########################################
# PostgreSQL
########################################
POSTGRES_DB=stock_sim
POSTGRES_USER=stock_sim
POSTGRES_PASSWORD=stock_sim

########################################
# Object Storage（笔记图片等；默认 MinIO）
########################################
STORAGE_TYPE=minio
# 容器内访问 MinIO
MINIO_ENDPOINT=http://minio:9000
# 浏览器访问 MinIO（签名 URL 会改写到该地址）
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stock-review
MINIO_USE_SSL=false
MINIO_REGION=

########################################
# 其他云存储（STORAGE_TYPE 切到对应值时填写）
########################################
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_BUCKET=

ALIYUN_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_BUCKET=

QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=z2
QINIU_DOMAIN=https://your-domain.com

# 本地直连后端开发用 DATABASE_URL（Compose 内 api 服务会覆盖为 postgres 主机名）
DATABASE_URL=postgresql+psycopg://stock_sim:stock_sim@localhost:5432/stock_sim
TUSHARE_TOKEN=
